# 复制为 backend/.env 后按实际修改
# ---- MSSQL 连接（默认读机器级注册表，这里可覆盖）----
# MSSQL_servername=192.168.129.8
# MSSQL_dbname=erpdatanew
# MSSQL_login=erpadmin
# MSSQL_pwd=********

# ---- 应用 ----
JWT_SECRET=请改成一段随机长字符串
JWT_EXPIRE_HOURS=12

# ERP 登录接口地址（走 ERP 登录校验时必填）。
# 默认契约：POST {username,password} -> HTTP 200 且 (success 为真 / code=0 / 含 token) 视为成功。
# 若你们 ERP 返回格式不同，改 backend/auth.py 的 _verify_via_erp 判断即可。
ERP_LOGIN_URL=

# 开发兜底：仅本地联调用。生产务必设为 0。
APP_DEV_FALLBACK=0
APP_DEV_PWD=123456

# 管理员工号（逗号分隔），可看全部统计、管理授权名单。也可在 meal_config.admin_emp_nos 维护。
APP_ADMIN_EMP_NOS=
